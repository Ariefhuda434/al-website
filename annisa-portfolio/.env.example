# Salin file ini menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.

# Alamat website setelah deploy (tanpa garis miring di akhir). Dipakai untuk SEO & gambar share.
NEXT_PUBLIC_SITE_URL=https://nama-kamu.vercel.app

# Nomor WhatsApp untuk form kontak, format internasional tanpa +, spasi, atau tanda hubung.
# Contoh: 6281234567890
NEXT_PUBLIC_WA_NUMBER=

# Email tujuan (dipakai kalau nomor WhatsApp kosong, dan ditampilkan di tombol kontak).
NEXT_PUBLIC_EMAIL=

# Username Instagram tanpa @
NEXT_PUBLIC_INSTAGRAM=
