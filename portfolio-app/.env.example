# Aiven MySQL - ambil dari dashboard Aiven, JANGAN commit file .env ke git
DATABASE_URL=mysql://avnadmin:PASSWORD@mysql-17c046aa-alvmitsuri.l.aivencloud.com:14086/defaultdb
# Isi dengan isi file ca.pem dari Aiven (base64), untuk verifikasi TLS yang ketat
DATABASE_CA_CERT_BASE64=

# Vercel Blob (tetap dipakai khusus untuk file gambar/pdf/audio)
BLOB_READ_WRITE_TOKEN=

# Session
SESSION_COOKIE_NAME=site_admin_session
SESSION_TTL_DAYS=7

NODE_ENV=production
