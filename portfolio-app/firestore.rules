rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.token.email != null &&
        get(/databases/$(database)/documents/adminSettings/main).data.allowedEmails.toSet().has(request.auth.token.email);
    }

    // Konten & daftar karya: siapa pun boleh baca (situs publik), hanya owner boleh tulis
    match /content/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /works/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Statistik kunjungan: tulis terbuka (pengunjung anonim), baca hanya owner
    match /visits/{doc} {
      allow read: if isOwner();
      allow create: if true;
    }

    // Log keamanan admin: tulis terbuka (percobaan sebelum login), baca hanya owner
    match /adminLogs/{doc} {
      allow read: if isOwner();
      allow create: if true;
    }

    // Pengaturan super admin: hanya owner
    match /adminSettings/{doc} {
      allow read, write: if isOwner();
    }
  }
}